{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:pagina/index.html", "destination": "/:pagina/", "permanent": true },
    { "source": "/", "has": [{ "type": "query", "key": "ref" }], "destination": "/baixar/", "permanent": false },
    { "source": "/post/:id(.*)", "destination": "/baixar/?abrir=post/:id", "permanent": false },
    { "source": "/artista/:id(.*)", "destination": "/baixar/?abrir=artista/:id", "permanent": false },
    { "source": "/agenda/(.*)", "destination": "/baixar/?abrir=agenda", "permanent": false },
    { "source": "/fa-clube/:id(.*)", "destination": "/baixar/?abrir=fa-clube/:id", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/fontes/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/telas/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
