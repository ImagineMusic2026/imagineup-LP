{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/:pagina/index.html", "destination": "/:pagina/", "permanent": true },
    { "source": "/post/(.*)", "destination": "/baixar/", "permanent": false },
    { "source": "/artista/(.*)", "destination": "/baixar/", "permanent": false },
    { "source": "/agenda/(.*)", "destination": "/baixar/", "permanent": false },
    { "source": "/fa-clube/(.*)", "destination": "/baixar/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/assets/fontes/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/telas/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
